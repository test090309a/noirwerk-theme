// ============================================================
// E-MAILS IN DATEI SPEICHERN (NUR FÜR TESTS!)
// ============================================================

// ============================================================
// E-MAIL-DEBUG (TEST)
// ============================================================

add_filter('wp_mail', function($args) {
    // Log-Datei erstellen
    $log_dir = '/var/www/html/wp-content/uploads/';
    if (!file_exists($log_dir)) {
        mkdir($log_dir, 0755, true);
    }
    
    $log_file = $log_dir . 'mail.log';
    $log = date('Y-m-d H:i:s') . "\n";
    $log .= "To: " . print_r($args['to'], true) . "\n";
    $log .= "Subject: " . $args['subject'] . "\n";
    $log .= "Message: " . $args['message'] . "\n";
    $log .= "Headers: " . print_r($args['headers'], true) . "\n";
    $log .= str_repeat('-', 50) . "\n\n";
    
    file_put_contents($log_file, $log, FILE_APPEND);
    
    // Auch als Debug-Log schreiben
    error_log('wp_mail wurde aufgerufen!');
    error_log('Empfänger: ' . print_r($args['to'], true));
    
    return $args;
}, 10, 1);

